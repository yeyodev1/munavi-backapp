# Plantilla — copiar a .env y rellenar. El .env real nunca se versiona.

# ─── Base ─────────────────────────────────────────────────────────────
DB_URI=mongodb://localhost:27017/munavi
PORT=8100
JWT_SECRET=cambiame_por_algo_largo
SLACK_ERROR_WEBHOOK=

# Orígenes CORS extra (producción, túneles), separados por coma
CORS_ORIGINS=
FRONTEND_URL=http://localhost:5173

# ─── Admin ────────────────────────────────────────────────────────────
# Cuenta de administración que se siembra al arrancar si no existe.
# Sin ADMIN_PASSWORD no se crea nada.
ADMIN_EMAIL=admin@munavi.ec
ADMIN_PASSWORD=
ADMIN_NAME=Administración

# ─── Correo (Resend) ──────────────────────────────────────────────────
# Sin la key el API funciona igual, pero no envía correos.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Munavi <onboarding@resend.dev>

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Avisos de pedidos ────────────────────────────────────────────────
# Correo que recibe el aviso de cada pedido nuevo (si settings.notifyEmail está vacío).
ADMIN_NOTIFY_EMAIL=

# ─── Payphone (Cajita de Pagos) ───────────────────────────────────────
# Sin token y store id el checkout con tarjeta responde 503; transferencia y contra entrega siguen funcionando.
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
